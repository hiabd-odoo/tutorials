<?xml version="1.0"?>
<odoo>
    <record id="estate_offer_list_view" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity_days"/>
                <field name="deadline"/>
                <button name="accept_offer" type="object" title="Accept" string="" icon="fa-check"/>
                <button name="refuse_offer" type="object" title="Refuse" string="" icon="fa-close"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="estate_offer_form_view" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Property Offer">
                <header>
                    <button name="accept_offer" type="object" string="Accept" icon="fa-check"/>
                    <button name="refuse_offer" type="object" string="Refuse" icon="fa-close"/>
                </header>
                <group>
                    <field name="price"/>
                    <field name="partner_id"/>
                    <field name="status"/>
                    <field name="validity_days"/>
                    <field name="deadline"/>
                </group>
            </form>
        </field>
    </record>
</odoo>